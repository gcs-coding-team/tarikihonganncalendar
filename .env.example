# Storage. Unset it and the API runs in memory, losing everything on restart —
# fine for a demo, not for anything you want to keep.
DATABASE_URL=postgres://user:password@localhost:5432/tarikihongann?sslmode=disable

HTTP_PORT=8080

# The one origin allowed to call this API from a browser. Leave it unset when
# the frontend is served from this same origin.
FRONTEND_ORIGIN=http://localhost:3000

# Reading photographed handouts. Without a model reachable, uploads still work
# and analysis reports that it is unavailable rather than inventing dates.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=180

# How many times to retry a model that cannot be reached. Covers one that is
# still loading; it does not paper over one that is not there.
WORKER_MAX_ATTEMPTS=3

# Where photographed handouts are kept, so they can be looked at again.
# Set it empty to read and then discard them.
BLOB_DIR=./data/prints

# Re-opens the shortcuts that predate passwords: a trusted X-User-ID header and
# passwordless session creation. Convenient against a local server, and a way
# straight past every password anywhere else. Leave it unset.
# ALLOW_DEV_AUTH=true

# ---- メール（パスワード再設定）----
# SMTP_HOST が空だと、再設定コードはサーバーのログに出るだけで誰にも届きません。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 差出人。空なら SMTP_USERNAME を使います。
SMTP_FROM=
# メール本文に入れるアプリのURL。
APP_URL=

# ---- docker compose 用 ----
POSTGRES_PASSWORD=
API_PORT=8080
# CPU のみの機械では1枚に数分かかります。
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MEMORY_LIMIT=6g
